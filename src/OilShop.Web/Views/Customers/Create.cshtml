@model Customer
@{
    ViewData["Title"] = "Add Customer";
}
<div class="card max-w-lg">
    <h2 class="font-bold text-lg mb-3">Add Customer</h2>
    <form asp-action="Create" method="post" class="space-y-3">
        <input class="input" asp-for="Name" placeholder="Customer Name" required />
        <input class="input" asp-for="Phone" placeholder="Phone (e.g. 03001234567)" required />
        <input class="input" asp-for="Address" placeholder="Address" />
        <input class="input" asp-for="Email" placeholder="Email" />
        <input class="input" asp-for="NTN" placeholder="NTN" />
        <button class="btn" type="submit">Save Customer</button>
    </form>
</div>
