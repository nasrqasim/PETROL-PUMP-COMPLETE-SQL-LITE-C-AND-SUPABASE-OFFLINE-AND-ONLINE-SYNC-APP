@model Customer
@{
    ViewData["Title"] = "Edit Customer";
}
<div class="card max-w-lg mx-auto border-t-4 border-blue-600">
    <h2 class="font-bold text-lg mb-3 text-slate-800">Edit Customer Account</h2>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="space-y-3">
        <div>
            <label class="block text-sm font-medium mb-1">Customer / Company Name</label>
            <input class="input w-full" asp-for="Name" required />
        </div>
        <div>
            <label class="block text-sm font-medium mb-1">Phone Number</label>
            <input class="input w-full" asp-for="Phone" required />
        </div>
        <div>
            <label class="block text-sm font-medium mb-1">Address</label>
            <input class="input w-full" asp-for="Address" />
        </div>
        <div class="grid grid-cols-2 gap-3">
            <div>
                <label class="block text-sm font-medium mb-1">Email</label>
                <input class="input w-full" asp-for="Email" type="email" />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">NTN / STRN</label>
                <input class="input w-full" asp-for="NTN" />
            </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
            <div>
                <label class="block text-sm font-medium mb-1">Current Balance Due (Rs.)</label>
                <input class="input w-full" asp-for="BalanceDue" type="number" step="0.01" />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Advance Amount (Rs.)</label>
                <input class="input w-full" asp-for="Advance" type="number" step="0.01" />
            </div>
        </div>
        <div class="flex gap-2 pt-2">
            <button class="btn btn-green px-6" type="submit">Update Customer</button>
            <a class="btn" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
