@model OilShop.Core.Services.ProfitLossResult
@{
    ViewData["Title"] = "Profit and Loss Report";
}
<div class="card">
    <div class="flex justify-between items-center mb-3">
        <h2 class="font-bold text-lg">Profit and Loss Report</h2>
        <span class="text-sm text-slate-500">Daily Profit Loss Statement — @(((DateTime)ViewBag.From).ToString("dd-MMM-yyyy")) to @(((DateTime)ViewBag.To).ToString("dd-MMM-yyyy"))</span>
    </div>
    <form method="get" class="flex gap-2 mb-4 no-print">
        <input class="input max-w-xs" type="date" name="from" value="@(((DateTime)ViewBag.From).ToString("yyyy-MM-dd"))" />
        <input class="input max-w-xs" type="date" name="to" value="@(((DateTime)ViewBag.To).ToString("yyyy-MM-dd"))" />
        <button class="btn" type="submit">Generate Report</button>
        <button class="btn" type="button" onclick="window.print()">Export PDF</button>
    </form>
    <div class="grid md:grid-cols-2 gap-4">
        <div class="border rounded overflow-hidden">
            <div class="bg-green-600 text-white font-bold px-3 py-2">Income</div>
            <table class="tbl">
                <tr><td>Total Revenue</td><td class="text-right font-bold text-green-600">Rs. @Model.TotalRevenue.ToString("N0")</td></tr>
                <tr><td>Sales Revenue</td><td class="text-right">Rs. @Model.SalesRevenue.ToString("N0")</td></tr>
                <tr><td>Cash Sales</td><td class="text-right">Rs. @Model.CashSales.ToString("N0")</td></tr>
                <tr><td>Credit Sales</td><td class="text-right">Rs. @Model.CreditSales.ToString("N0")</td></tr>
                <tr><td>Other Income</td><td class="text-right">Rs. @Model.OtherIncome.ToString("N0")</td></tr>
            </table>
        </div>
        <div class="border rounded overflow-hidden">
            <div class="bg-red-600 text-white font-bold px-3 py-2">Expenses</div>
            <table class="tbl">
                <tr><td>Total Expenses</td><td class="text-right font-bold text-red-600">Rs. @Model.TotalExpenses.ToString("N0")</td></tr>
                <tr><td>Purchase Cost</td><td class="text-right">Rs. @Model.PurchaseCost.ToString("N0")</td></tr>
                <tr><td>Staff Salaries</td><td class="text-right">Rs. @Model.StaffSalaries.ToString("N0")</td></tr>
                <tr><td>Utilities Bill</td><td class="text-right">Rs. @Model.UtilitiesBill.ToString("N0")</td></tr>
                <tr><td>Rent Expense</td><td class="text-right">Rs. @Model.RentExpense.ToString("N0")</td></tr>
                <tr><td>Fuel Cost</td><td class="text-right">Rs. @Model.FuelCost.ToString("N0")</td></tr>
            </table>
        </div>
    </div>
    <div class="mt-4 p-4 bg-green-50 border border-green-300 rounded flex justify-between items-center">
        <div><div class="text-sm text-slate-500">Net Profit</div><div class="text-3xl font-bold text-green-600">Rs. @Model.NetProfit.ToString("N0")</div></div>
        <div class="text-right"><div class="text-sm text-slate-500">Profit Margin</div><div class="text-2xl font-bold bg-blue-600 text-white px-3 py-1 rounded">@Model.ProfitMarginPercent.ToString("0.0")%</div></div>
    </div>
    <p class="text-xs text-slate-500 mt-3">Demo reference (15-Oct-2025, from the user's screenshot): Total Revenue Rs. 125,600, Total Expenses Rs. 98,450, Net Profit Rs. 27,150, Profit Margin 21.6%. This report computes live from the invoices and expenses in the database.</p>
</div>
