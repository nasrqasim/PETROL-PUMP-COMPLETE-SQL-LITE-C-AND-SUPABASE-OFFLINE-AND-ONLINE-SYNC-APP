@model IEnumerable<(string Category, string Name)>
@{
    ViewData["Title"] = "Reports Center";
    var categories = Model.Select(r => r.Category).Distinct().ToList();
}
<div class="space-y-6">
    <div class="card border-l-4 border-[#1e3a8a] flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
            <h2 class="font-bold text-xl text-[#1e3a8a]">Business Reports Center</h2>
            <p class="text-xs text-slate-500">Comprehensive reporting suite covering Sales, Purchases, Financials, Inventory, and Payroll</p>
        </div>
        <div class="flex gap-2">
            <a class="btn btn-green text-xs" asp-action="ProfitLoss">📊 Profit &amp; Loss Statement</a>
        </div>
    </div>

    <!-- Category Tabs & Search Filter -->
    <div class="card bg-slate-50 border">
        <div class="grid md:grid-cols-3 gap-3 items-end">
            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Filter by Category</label>
                <select class="input w-full text-sm" id="catFilter" onchange="filterReports()">
                    <option value="">All Categories (@Model.Count() Reports)</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat">@cat</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Search Report Title</label>
                <input class="input w-full text-sm" id="searchBox" placeholder="Type report name..." oninput="filterReports()" />
            </div>
            <div>
                <button type="button" onclick="document.getElementById('catFilter').value='';document.getElementById('searchBox').value='';filterReports();" class="btn text-sm w-full">Clear Filters</button>
            </div>
        </div>
    </div>

    <!-- Categorized Grid / Cards -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4" id="reportsGrid">
        @foreach (var group in Model.GroupBy(r => r.Category))
        {
            <div class="card border-t-4 @(group.Key.Contains("Purchase") ? "border-amber-500" : (group.Key.Contains("Sale") ? "border-green-600" : (group.Key.Contains("Financial") ? "border-blue-800" : (group.Key.Contains("Inventory") ? "border-purple-600" : "border-slate-700")))) category-block" data-category="@group.Key">
                <div class="flex justify-between items-center mb-3 pb-2 border-b">
                    <h3 class="font-bold text-sm text-slate-800 uppercase tracking-wider">@group.Key</h3>
                    <span class="text-xs bg-slate-100 text-slate-600 px-2 py-0.5 rounded font-mono">@group.Count() reports</span>
                </div>
                <div class="space-y-1.5">
                    @foreach (var r in group)
                    {
                        <div class="report-item flex justify-between items-center py-1.5 px-2 rounded hover:bg-slate-50 transition" data-name="@r.Name.ToLower()">
                            <span class="text-sm font-medium text-slate-700">@r.Name</span>
                            <div class="flex gap-1">
                                <a class="px-2 py-0.5 bg-[#1e3a8a] hover:bg-blue-900 text-white rounded text-xs" asp-action="Generate" asp-route-name="@r.Name">Generate</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
function filterReports() {
    const selectedCat = document.getElementById('catFilter').value;
    const query = document.getElementById('searchBox').value.toLowerCase().trim();

    document.querySelectorAll('.category-block').forEach(block => {
        const cat = block.getAttribute('data-category');
        const catMatch = !selectedCat || cat === selectedCat;
        let visibleCount = 0;

        block.querySelectorAll('.report-item').forEach(item => {
            const name = item.getAttribute('data-name');
            const nameMatch = !query || name.includes(query);
            if (nameMatch) {
                item.style.display = 'flex';
                visibleCount++;
            } else {
                item.style.display = 'none';
            }
        });

        if (catMatch && visibleCount > 0) {
            block.style.display = '';
        } else {
            block.style.display = 'none';
        }
    });
}
</script>
}
