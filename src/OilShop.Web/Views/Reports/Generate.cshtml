@model OilShop.Web.Models.ReportResultModel
@{
    ViewData["Title"] = Model.ReportName;
    var customers = (List<OilShop.Core.Models.Customer>)ViewBag.Customers;
    var suppliers = (List<OilShop.Core.Models.Supplier>)ViewBag.Suppliers;
    var products = (List<OilShop.Core.Models.Product>)ViewBag.Products;
    var staff = (List<OilShop.Core.Models.StaffMember>)ViewBag.Staff;
    var categories = (List<string>)ViewBag.Categories;
}

<div class="space-y-4">
    <!-- Header banner -->
    <div class="card border-l-4 border-[#1e3a8a] flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
            <div class="text-xs text-blue-700 font-bold uppercase tracking-wider">ROONJHA DEVELOPERS OIL SHOP • @Model.ReportCategory</div>
            <h1 class="text-2xl font-black text-slate-800">@Model.ReportName</h1>
            <p class="text-xs text-slate-500 mt-0.5">@Model.Description</p>
        </div>
        <div class="flex flex-wrap gap-2 no-print items-center">
            <button class="btn btn-green text-xs" onclick="window.print()">🖨️ Print / PDF</button>
            <a class="btn text-xs bg-emerald-700 hover:bg-emerald-800 text-white" 
               href="@Url.Action("ExportExcel", Model.Filter)">📊 Excel Export</a>
            <a class="btn text-xs bg-slate-700 hover:bg-slate-800 text-white" 
               href="@Url.Action("ExportCsv", Model.Filter)">📄 CSV Export</a>
            <a class="btn text-xs" asp-action="Index">← Reports Center</a>
        </div>
    </div>

    <!-- Multi-criteria Filter Bar -->
    <div class="card bg-slate-50 border no-print">
        <form method="get" asp-action="Generate" id="reportFilterForm" class="space-y-3">
            <input type="hidden" name="ReportName" value="@Model.ReportName" />
            <input type="hidden" name="SortBy" id="filterSortBy" value="@Model.Filter.SortBy" />
            <input type="hidden" name="SortOrder" id="filterSortOrder" value="@Model.Filter.SortOrder" />
            <input type="hidden" name="Page" id="filterPage" value="1" />

            <!-- Row 1: Date Presets & Custom Range -->
            <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-2">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Date Period</label>
                    <select class="input w-full text-xs" name="DatePreset" id="datePresetSelect" onchange="handlePresetChange()">
                        <option value="all" selected="@(Model.Filter.DatePreset == "all" ? "selected" : null)">All Time</option>
                        <option value="today" selected="@(Model.Filter.DatePreset == "today" ? "selected" : null)">Today</option>
                        <option value="yesterday" selected="@(Model.Filter.DatePreset == "yesterday" ? "selected" : null)">Yesterday</option>
                        <option value="this_week" selected="@(Model.Filter.DatePreset == "this_week" ? "selected" : null)">This Week</option>
                        <option value="this_month" selected="@(Model.Filter.DatePreset == "this_month" ? "selected" : null)">This Month</option>
                        <option value="prev_month" selected="@(Model.Filter.DatePreset == "prev_month" ? "selected" : null)">Previous Month</option>
                        <option value="this_year" selected="@(Model.Filter.DatePreset == "this_year" ? "selected" : null)">This Year</option>
                        <option value="custom" selected="@(Model.Filter.DatePreset == "custom" ? "selected" : null)">Custom Range</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Start Date</label>
                    <input class="input w-full text-xs" type="date" name="FromDate" id="fromDateInput" value="@Model.Filter.FromDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">End Date</label>
                    <input class="input w-full text-xs" type="date" name="ToDate" id="toDateInput" value="@Model.Filter.ToDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Search Keywords</label>
                    <input class="input w-full text-xs" name="Search" value="@Model.Filter.Search" placeholder="Ref #, Party, Item, Remarks..." />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Customer</label>
                    <select class="input w-full text-xs" name="CustomerId">
                        <option value="">All Customers</option>
                        @foreach (var c in customers)
                        {
                            <option value="@c.Id" selected="@(Model.Filter.CustomerId == c.Id ? "selected" : null)">@c.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Supplier / Vendor</label>
                    <select class="input w-full text-xs" name="SupplierId">
                        <option value="">All Vendors</option>
                        @foreach (var s in suppliers)
                        {
                            <option value="@s.Id" selected="@(Model.Filter.SupplierId == s.Id ? "selected" : null)">@s.Name</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Row 2: Secondary Filters & Action Buttons -->
            <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-2 pt-1">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Product Item</label>
                    <select class="input w-full text-xs" name="ProductId">
                        <option value="">All Products</option>
                        @foreach (var p in products)
                        {
                            <option value="@p.Id" selected="@(Model.Filter.ProductId == p.Id ? "selected" : null)">@p.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Category</label>
                    <select class="input w-full text-xs" name="Category">
                        <option value="">All Categories</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat" selected="@(Model.Filter.Category == cat ? "selected" : null)">@cat</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Payment Method</label>
                    <select class="input w-full text-xs" name="PaymentMode">
                        <option value="">All Payment Modes</option>
                        <option value="Cash" selected="@(Model.Filter.PaymentMode == "Cash" ? "selected" : null)">Cash</option>
                        <option value="Bank" selected="@(Model.Filter.PaymentMode == "Bank" ? "selected" : null)">Bank</option>
                        <option value="Credit" selected="@(Model.Filter.PaymentMode == "Credit" ? "selected" : null)">Credit</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Salesperson / Staff</label>
                    <select class="input w-full text-xs" name="StaffId">
                        <option value="">All Staff</option>
                        @foreach (var st in staff)
                        {
                            <option value="@st.Id" selected="@(Model.Filter.StaffId == st.Id ? "selected" : null)">@st.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Rows Per Page</label>
                    <select class="input w-full text-xs" name="PageSize" onchange="document.getElementById('reportFilterForm').submit()">
                        <option value="15" selected="@(Model.PageSize == 15 ? "selected" : null)">15 rows</option>
                        <option value="25" selected="@(Model.PageSize == 25 ? "selected" : null)">25 rows</option>
                        <option value="50" selected="@(Model.PageSize == 50 ? "selected" : null)">50 rows</option>
                        <option value="100" selected="@(Model.PageSize == 100 ? "selected" : null)">100 rows</option>
                    </select>
                </div>
                <div class="flex gap-1 items-end">
                    <button type="submit" class="btn btn-green text-xs w-full py-2">🔍 Apply Filter</button>
                    <a href="@Url.Action("Generate", new { ReportName = Model.ReportName })" class="btn text-xs py-2">Reset</a>
                </div>
            </div>
        </form>
    </div>

    <!-- Summary KPI Cards -->
    @if (Model.Summaries.Any())
    {
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
            @foreach (var s in Model.Summaries)
            {
                <div class="p-3 bg-white rounded-lg shadow-sm border border-slate-200">
                    <div class="text-xs text-slate-500 font-semibold uppercase tracking-wider">@s.Label</div>
                    <div class="text-xl font-black mt-1 @(s.ColorClass ?? "text-slate-800")">@s.Value</div>
                </div>
            }
        </div>
    }

    <!-- Main Data Table -->
    <div class="card overflow-x-auto">
        <div class="flex justify-between items-center mb-2 text-xs text-slate-500">
            <span>Showing @Model.Rows.Count of @Model.TotalRows filtered records</span>
            @if (Model.TotalPages > 1)
            {
                <span>Page @Model.CurrentPage of @Model.TotalPages</span>
            }
        </div>

        <table class="tbl text-sm">
            <thead>
                <tr>
                    @foreach (var col in Model.Columns)
                    {
                        var isSorted = Model.Filter.SortBy == col.Key;
                        var nextOrder = (isSorted && Model.Filter.SortOrder == "asc") ? "desc" : "asc";
                        <th class="@(col.IsNumeric ? "text-right" : "") whitespace-nowrap">
                            @if (col.Sortable)
                            {
                                <a href="javascript:void(0)" onclick="sortByColumn('@col.Key', '@nextOrder')" class="hover:text-blue-900 inline-flex items-center gap-1">
                                    @col.Title
                                    @if (isSorted)
                                    {
                                        <span>@(Model.Filter.SortOrder == "asc" ? "▲" : "▼")</span>
                                    }
                                </a>
                            }
                            else
                            {
                                @col.Title
                            }
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        @foreach (var col in Model.Columns)
                        {
                            var cell = row.ContainsKey(col.Key) ? row[col.Key] : null;
                            var val = cell?.Text ?? "—";
                            <td class="@(col.IsNumeric ? "text-right font-medium" : "") @(col.Key == "Balance" || col.Key == "GrandTotal" ? "font-bold text-slate-900" : "") whitespace-nowrap">
                                @if (cell != null && !string.IsNullOrEmpty(cell.BadgeClass))
                                {
                                    <span class="px-2 py-0.5 rounded text-xs @cell.BadgeClass">@val</span>
                                }
                                else if (cell != null && !string.IsNullOrEmpty(cell.LinkUrl))
                                {
                                    <a href="@cell.LinkUrl" class="text-blue-700 hover:underline font-mono text-xs font-semibold">@val</a>
                                }
                                else
                                {
                                    @val
                                }
                            </td>
                        }
                    </tr>
                }
                @if (!Model.Rows.Any())
                {
                    <tr>
                        <td colspan="@Model.Columns.Count" class="text-center py-8 text-slate-500">
                            No records found matching the active filter criteria.
                        </td>
                    </tr>
                }
            </tbody>
            @if (Model.Totals.Any())
            {
                <tfoot>
                    <tr class="font-bold border-t-2 border-slate-300 bg-slate-50">
                        @foreach (var col in Model.Columns)
                        {
                            if (Model.Totals.ContainsKey(col.Key))
                            {
                                <td class="text-right text-base text-[#1e3a8a]">Rs. @Model.Totals[col.Key].ToString("N0")</td>
                            }
                            else if (col == Model.Columns.First())
                            {
                                <td>TOTAL:</td>
                            }
                            else
                            {
                                <td></td>
                            }
                        }
                    </tr>
                </tfoot>
            }
        </table>

        <!-- Pagination Controls -->
        @if (Model.TotalPages > 1)
        {
            <div class="mt-4 flex justify-between items-center no-print pt-3 border-t">
                <div class="text-xs text-slate-500">
                    Page @Model.CurrentPage of @Model.TotalPages (@Model.TotalRows total records)
                </div>
                <div class="flex gap-1">
                    @if (Model.CurrentPage > 1)
                    {
                        <button type="button" class="btn text-xs" onclick="goToPage(1)">« First</button>
                        <button type="button" class="btn text-xs" onclick="goToPage(@(Model.CurrentPage - 1))">‹ Previous</button>
                    }
                    @for (int p = Math.Max(1, Model.CurrentPage - 2); p <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); p++)
                    {
                        if (p == Model.CurrentPage)
                        {
                            <span class="px-3 py-1 bg-[#1e3a8a] text-white text-xs font-bold rounded">@p</span>
                        }
                        else
                        {
                            <button type="button" class="btn text-xs" onclick="goToPage(@p)">@p</button>
                        }
                    }
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <button type="button" class="btn text-xs" onclick="goToPage(@(Model.CurrentPage + 1))">Next ›</button>
                        <button type="button" class="btn text-xs" onclick="goToPage(@Model.TotalPages)">Last »</button>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
function handlePresetChange() {
    var preset = document.getElementById('datePresetSelect').value;
    if (preset !== 'custom') {
        document.getElementById('reportFilterForm').submit();
    }
}

function sortByColumn(colKey, order) {
    document.getElementById('filterSortBy').value = colKey;
    document.getElementById('filterSortOrder').value = order;
    document.getElementById('reportFilterForm').submit();
}

function goToPage(page) {
    document.getElementById('filterPage').value = page;
    document.getElementById('reportFilterForm').submit();
}
</script>
}
