@model PurchaseInvoice
@{
    ViewData["Title"] = "New Purchase Invoice";
    var suppliers = (List<Supplier>)ViewBag.Suppliers;
    var products = (List<Product>)ViewBag.Products;
}
<div class="card">
    <h2 class="font-bold text-lg mb-3">New Purchase Invoice</h2>
    <form asp-action="Create" method="post">
        <div class="grid md:grid-cols-3 gap-3 mb-4">
            <div><label class="text-sm">Supplier Name</label>
                <select class="input" asp-for="SupplierId" required>
                    @foreach (var s in suppliers) { <option value="@s.Id">@s.Name</option> }
                </select></div>
            <div><label class="text-sm">Date</label><input class="input" asp-for="Date" type="date" required /></div>
            <div><label class="text-sm">Payment Mode</label>
                <select class="input" asp-for="PaymentMode">
                    <option>Cash</option><option>Bank</option><option>Credit</option>
                </select></div>
            <div><label class="text-sm">Discount Rs.</label><input class="input" asp-for="Discount" type="number" step="0.01" min="0" value="0" /></div>
            <div><label class="text-sm">Tax Rs.</label><input class="input" asp-for="Tax" type="number" step="0.01" min="0" value="0" /></div>
        </div>
        <h3 class="font-bold mb-2">Product List</h3>
        <table class="tbl">
            <thead><tr><th>Product</th><th>Quantity</th><th>Unit Price</th><th>Tax</th></tr></thead>
            <tbody>
            @for (int i = 0; i < Model.Lines.Count; i++)
            {
                <tr>
                    <td><select class="input" name="Lines[@i].ProductId">
                        @foreach (var p in products) { <option value="@p.Id">@p.Name</option> }
                    </select></td>
                    <td><input class="input" type="number" step="0.01" min="0" name="Lines[@i].Quantity" value="1" /></td>
                    <td><input class="input" type="number" step="0.01" min="0" name="Lines[@i].UnitPrice" placeholder="Rs." /></td>
                    <td><input class="input" type="number" step="0.01" min="0" name="Lines[@i].Tax" value="0" /></td>
                </tr>
            }
            </tbody>
        </table>
        <div class="mt-4 flex gap-2">
            <button class="btn btn-green" type="submit">Save Invoice</button>
            <a class="btn" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
