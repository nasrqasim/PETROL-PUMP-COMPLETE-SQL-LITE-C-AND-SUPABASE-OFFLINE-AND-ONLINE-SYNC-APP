@model SalesInvoice
@{
    ViewData["Title"] = "New Sales Invoice";
    var customers = (List<Customer>)ViewBag.Customers;
    var products = (List<Product>)ViewBag.Products;
    var staff = (List<StaffMember>)ViewBag.Staff;
}
<div class="card">
    <h2 class="font-bold text-lg mb-3">New Sales Invoice</h2>
    <form asp-action="Create" method="post" id="invoiceForm">
        <div class="grid md:grid-cols-3 gap-3 mb-4">
            <div><label class="text-sm">Customer Name</label>
                <select class="input" asp-for="CustomerId" required>
                    @foreach (var c in customers) { <option value="@c.Id">@c.Name</option> }
                </select></div>
            <div><label class="text-sm">Date</label><input class="input" asp-for="Date" type="date" required /></div>
            <div><label class="text-sm">Payment Mode</label>
                <select class="input" asp-for="PaymentMode">
                    <option>Cash</option><option>Bank</option><option>Credit</option>
                </select></div>
            <div><label class="text-sm">Sold By (Staff)</label>
                <select class="input" asp-for="StaffId">
                    @foreach (var s in staff) { <option value="@s.Id">@s.Name (@s.EmployeeId)</option> }
                </select></div>
            <div><label class="text-sm">Discount Rs.</label><input class="input" asp-for="Discount" type="number" step="0.01" min="0" value="0" /></div>
            <div><label class="text-sm">Tax Rs.</label><input class="input" asp-for="Tax" type="number" step="0.01" min="0" value="0" /></div>
        </div>
        <h3 class="font-bold mb-2">Product List</h3>
        <table class="tbl" id="linesTable">
            <thead><tr><th>Product</th><th>Quantity</th><th>Unit Price</th><th>Tax</th><th></th></tr></thead>
            <tbody>
            @for (int i = 0; i < Model.Lines.Count; i++)
            {
                <tr>
                    <td><select class="input" name="Lines[@i].ProductId">
                        @foreach (var p in products) { <option value="@p.Id">@p.Name — Rs. @p.SalePrice</option> }
                    </select></td>
                    <td><input class="input" type="number" step="0.01" min="0" name="Lines[@i].Quantity" value="1" /></td>
                    <td><input class="input" type="number" step="0.01" min="0" name="Lines[@i].UnitPrice" placeholder="Rs." /></td>
                    <td><input class="input" type="number" step="0.01" min="0" name="Lines[@i].Tax" value="0" /></td>
                    <td><button type="button" class="btn btn-red" onclick="this.closest('tr').remove()">Remove</button></td>
                </tr>
            }
            </tbody>
        </table>
        <button type="button" class="btn mt-2" onclick="addLine()">+ Add Product Line</button>
        <div class="mt-4 flex gap-2">
            <button class="btn btn-green" type="submit">Save Invoice</button>
            <a class="btn" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
@section Scripts {
<script>
let lineIndex = @Model.Lines.Count;
function addLine() {
    const tbody = document.querySelector('#linesTable tbody');
    const row = document.createElement('tr');
    row.innerHTML = `<td><select class="input" name="Lines[${lineIndex}].ProductId">@foreach (var p in products) { <option value="@p.Id">@p.Name — Rs. @p.SalePrice</option> }</select></td>
    <td><input class="input" type="number" step="0.01" min="0" name="Lines[${lineIndex}].Quantity" value="1" /></td>
    <td><input class="input" type="number" step="0.01" min="0" name="Lines[${lineIndex}].UnitPrice" placeholder="Rs." /></td>
    <td><input class="input" type="number" step="0.01" min="0" name="Lines[${lineIndex}].Tax" value="0" /></td>
    <td><button type="button" class="btn btn-red" onclick="this.closest('tr').remove()">Remove</button></td>`;
    tbody.appendChild(row);
    lineIndex++;
}
</script>
}
