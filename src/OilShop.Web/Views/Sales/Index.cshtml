@model List<SalesInvoice>
@{
    ViewData["Title"] = "Sales Invoices";
}
<div class="space-y-4">
    <div class="card">
        <div class="flex justify-between items-center mb-3">
            <div>
                <h2 class="font-bold text-lg text-slate-800">Sales Invoices &amp; Billing</h2>
                <p class="text-xs text-slate-500">Search invoices, filter by date, view, edit, print, or delete transactions</p>
            </div>
            <div class="flex items-center gap-3">
                <div class="bg-blue-50 border border-blue-200 px-3 py-1 rounded-lg text-right">
                    <span class="text-xs text-blue-700 font-semibold uppercase">Total Filtered</span>
                    <span class="text-lg font-black text-[#1e3a8a] ml-2">Rs. @(((decimal)ViewBag.TotalRevenue).ToString("N0"))</span>
                </div>
                <a class="btn btn-green text-sm" asp-action="Create">+ New Sale Invoice</a>
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="bg-slate-50 p-3 rounded border mb-4">
            <form method="get" class="grid md:grid-cols-5 gap-3 items-end">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Search Keywords</label>
                    <input class="input w-full text-sm" name="search" value="@ViewBag.Search" placeholder="Invoice #, Customer, Remarks..." />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Payment Mode</label>
                    <select class="input w-full text-sm" name="paymentMode">
                        <option value="">All Modes</option>
                        <option value="Cash" selected="@(ViewBag.PaymentMode?.ToString() == "Cash" ? "selected" : null)">Cash</option>
                        <option value="Bank" selected="@(ViewBag.PaymentMode?.ToString() == "Bank" ? "selected" : null)">Bank</option>
                        <option value="Credit" selected="@(ViewBag.PaymentMode?.ToString() == "Credit" ? "selected" : null)">Credit</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">From Date</label>
                    <input class="input w-full text-sm" type="date" name="fromDate" value="@ViewBag.FromDate" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">To Date</label>
                    <input class="input w-full text-sm" type="date" name="toDate" value="@ViewBag.ToDate" />
                </div>
                <div class="flex gap-2">
                    <button type="submit" class="btn w-full text-sm">🔍 Filter</button>
                    <a asp-action="Index" class="btn text-sm">Reset</a>
                </div>
            </form>
        </div>

        <table class="tbl">
            <thead>
                <tr>
                    <th>Invoice No.</th>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Payment Mode</th>
                    <th class="text-right">Grand Total</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var i in Model)
            {
                <tr>
                    <td class="font-mono font-semibold text-[#1e3a8a]">
                        <a asp-action="Print" asp-route-id="@i.Id" class="hover:underline">@i.InvoiceNumber</a>
                    </td>
                    <td>@i.Date.ToString("dd-MMM-yyyy")</td>
                    <td class="font-medium">@(i.Customer?.Name ?? "Walk-in Customer")</td>
                    <td>
                        <span class="px-2 py-0.5 rounded text-xs font-semibold @(i.PaymentMode == PaymentMode.Credit ? "bg-amber-100 text-amber-800" : (i.PaymentMode == PaymentMode.Cash ? "bg-green-100 text-green-800" : "bg-blue-100 text-blue-800"))">
                            @i.PaymentMode
                        </span>
                    </td>
                    <td class="text-right font-bold">Rs. @i.GrandTotal.ToString("N0")</td>
                    <td class="space-x-2 text-xs">
                        <a class="text-blue-700 hover:underline font-semibold" asp-action="Print" asp-route-id="@i.Id">Print</a>
                        <a class="text-slate-700 hover:underline font-semibold" asp-action="Edit" asp-route-id="@i.Id">Edit</a>
                        <form asp-action="Delete" asp-route-id="@i.Id" method="post" onsubmit="return confirm('Delete invoice @i.InvoiceNumber and restore inventory stock?');" class="inline">
                            <button type="submit" class="text-red-600 hover:underline font-semibold">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-center py-6 text-slate-500">No sales invoices found matching filter.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
