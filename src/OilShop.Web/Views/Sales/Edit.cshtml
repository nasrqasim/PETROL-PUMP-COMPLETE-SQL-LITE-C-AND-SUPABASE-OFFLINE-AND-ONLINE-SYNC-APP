@model SalesInvoice
@{
    ViewData["Title"] = "Edit Sales Invoice";
    var customers = (List<Customer>)ViewBag.Customers;
    var staff = (List<StaffMember>)ViewBag.Staff;
}
<div class="card max-w-2xl mx-auto border-t-4 border-blue-600">
    <div class="flex justify-between items-center mb-3">
        <h2 class="font-bold text-lg text-slate-800">Edit Sales Invoice @Model.InvoiceNumber</h2>
        <a asp-action="Print" asp-route-id="@Model.Id" class="text-xs text-blue-700 hover:underline">View Print Preview →</a>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="space-y-4">
        <div class="grid md:grid-cols-2 gap-3">
            <div>
                <label class="block text-sm font-medium mb-1">Customer</label>
                <select class="input w-full" asp-for="CustomerId" required>
                    @foreach (var c in customers)
                    {
                        if (Model.CustomerId == c.Id)
                        {
                            <option value="@c.Id" selected>@c.Name</option>
                        }
                        else
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    }
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Invoice Date</label>
                <input class="input w-full" asp-for="Date" type="date" value="@Model.Date.ToString("yyyy-MM-dd")" required />
            </div>
        </div>

        <div class="grid md:grid-cols-2 gap-3">
            <div>
                <label class="block text-sm font-medium mb-1">Payment Mode</label>
                <select class="input w-full" asp-for="PaymentMode">
                    <option value="Cash" selected="@(Model.PaymentMode == PaymentMode.Cash ? "selected" : null)">Cash</option>
                    <option value="Bank" selected="@(Model.PaymentMode == PaymentMode.Bank ? "selected" : null)">Bank</option>
                    <option value="Credit" selected="@(Model.PaymentMode == PaymentMode.Credit ? "selected" : null)">Credit</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Sold By Staff</label>
                <select class="input w-full" asp-for="StaffId">
                    <option value="">-- None --</option>
                    @foreach (var s in staff)
                    {
                        if (Model.StaffId == s.Id)
                        {
                            <option value="@s.Id" selected>@s.Name (@s.EmployeeId)</option>
                        }
                        else
                        {
                            <option value="@s.Id">@s.Name (@s.EmployeeId)</option>
                        }
                    }
                </select>
            </div>
        </div>

        <!-- Product Line Items overview -->
        <div>
            <label class="block text-sm font-medium mb-1">Product Lines</label>
            <table class="tbl text-xs">
                <thead><tr><th>Product Name</th><th>Qty</th><th>Unit Price</th><th>Tax</th><th class="text-right">Line Total</th></tr></thead>
                <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td class="font-medium">@line.ProductName</td>
                        <td>@line.Quantity</td>
                        <td>Rs. @line.UnitPrice.ToString("N0")</td>
                        <td>Rs. @line.Tax.ToString("N0")</td>
                        <td class="text-right font-bold">Rs. @((line.Quantity * line.UnitPrice).ToString("N0"))</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="grid md:grid-cols-2 gap-3">
            <div>
                <label class="block text-sm font-medium mb-1">Discount Rs.</label>
                <input class="input w-full" asp-for="Discount" type="number" step="0.01" min="0" />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Tax Rs.</label>
                <input class="input w-full" asp-for="Tax" type="number" step="0.01" min="0" />
            </div>
        </div>

        <div>
            <label class="block text-sm font-medium mb-1">Remarks</label>
            <input class="input w-full" asp-for="Remarks" />
        </div>

        <div class="flex gap-2 pt-2">
            <button class="btn btn-green px-6" type="submit">Update Invoice</button>
            <a class="btn" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
