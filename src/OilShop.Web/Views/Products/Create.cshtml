@model Product
@{
    ViewData["Title"] = "Add Product";
}
<div class="card max-w-lg mx-auto">
    <h2 class="font-bold text-lg mb-3">Add Product / Fuel Item</h2>
    <form asp-action="Create" method="post" class="space-y-3">
        <div>
            <label class="block text-sm font-medium mb-1">Product Name</label>
            <input class="input w-full" asp-for="Name" placeholder="e.g. Diesel Fuel, Engine Oil 20W50" required />
        </div>
        <div>
            <label class="block text-sm font-medium mb-1">Category</label>
            <input class="input w-full" asp-for="Category" placeholder="Fuel / Engine Oil / Lubricant" />
        </div>
        <div>
            <label class="block text-sm font-medium mb-1">Unit of Measure</label>
            <select class="input w-full" asp-for="Unit">
                <option value="Liters">Liters (Ltr)</option>
                <option value="Gallons">Gallons (Gal)</option>
                <option value="Cartons">Cartons (Ctn)</option>
                <option value="Drums">Drums</option>
                <option value="Bottles">Bottles</option>
                <option value="Pieces">Pieces</option>
            </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
            <div>
                <label class="block text-sm font-medium mb-1">Sale Price Rs.</label>
                <input class="input w-full" asp-for="SalePrice" type="number" step="0.01" placeholder="0.00" required />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Purchase Price Rs.</label>
                <input class="input w-full" asp-for="PurchasePrice" type="number" step="0.01" placeholder="0.00" />
            </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
            <div>
                <label class="block text-sm font-medium mb-1">Opening Stock Quantity</label>
                <input class="input w-full" asp-for="StockQuantity" type="number" step="0.01" placeholder="0.00" />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Low Stock Alert Level</label>
                <input class="input w-full" asp-for="LowStockAlert" type="number" step="0.01" value="10" />
            </div>
        </div>
        <div class="flex gap-2 pt-2">
            <button class="btn btn-green" type="submit">Save Product</button>
            <a asp-action="Index" class="btn">Cancel</a>
        </div>
    </form>
</div>
