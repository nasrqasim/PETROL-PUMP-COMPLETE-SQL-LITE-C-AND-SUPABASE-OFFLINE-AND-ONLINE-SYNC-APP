@model Product
@{
    ViewData["Title"] = "Edit Product";
}
<div class="card max-w-lg mx-auto border-t-4 border-blue-600">
    <h2 class="font-bold text-lg mb-3 text-slate-800">Edit Product: @Model.Name</h2>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="space-y-3">
        <div>
            <label class="block text-sm font-medium mb-1">Product Name</label>
            <input class="input w-full" asp-for="Name" required />
        </div>
        <div>
            <label class="block text-sm font-medium mb-1">Category</label>
            <input class="input w-full" asp-for="Category" />
        </div>
        <div>
            <label class="block text-sm font-medium mb-1">Unit of Measure</label>
            <select class="input w-full" asp-for="Unit">
                <option value="Liters">Liters (Ltr)</option>
                <option value="Gallons">Gallons (Gal)</option>
                <option value="Cartons">Cartons (Ctn)</option>
                <option value="Drums">Drums</option>
                <option value="Bottles">Bottles</option>
                <option value="Pieces">Pieces</option>
            </select>
        </div>
        <div class="grid grid-cols-2 gap-3">
            <div>
                <label class="block text-sm font-medium mb-1">Purchase Price Rs.</label>
                <input class="input w-full" asp-for="PurchasePrice" type="number" step="0.01" />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Sale Price Rs.</label>
                <input class="input w-full" asp-for="SalePrice" type="number" step="0.01" required />
            </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
            <div>
                <label class="block text-sm font-medium mb-1">Current Stock</label>
                <input class="input w-full" asp-for="StockQuantity" type="number" step="0.01" required />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Low Stock Alert Level</label>
                <input class="input w-full" asp-for="LowStockAlert" type="number" step="0.01" />
            </div>
        </div>
        <div class="flex gap-2 pt-2">
            <button class="btn btn-green px-6" type="submit">Update Product</button>
            <a class="btn" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
