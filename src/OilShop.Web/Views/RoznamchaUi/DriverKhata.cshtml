@model List<OilShop.Core.Models.RoznamchaEntry>
@{
    ViewData["Title"] = "Driver Wise Khata (Driver Ledger)";
    var drivers = ViewBag.Drivers as List<string> ?? new();
    var selectedDriver = ViewBag.SelectedDriver as string ?? "Iqbal";

    var uniqueWorkingDays = Model.Select(r => r.Date.Date).Distinct().Count();
    var totalTrips = Model.Count;
    var totalKiraya = Model.Sum(r => r.Kiraya);
    var totalKharcha = Model.Sum(r => r.Kharcha);
    var totalAdvance = Model.Sum(r => r.Advance);
    var totalDiesel = Model.Sum(r => r.DieselLiter);
    var driverBaqaya = totalKiraya - totalKharcha - totalAdvance;
    var vehiclesOperated = Model.Select(r => r.GariNo).Distinct().ToList();
}

<div class="space-y-6">
    <!-- Header -->
    <div class="card flex justify-between items-center">
        <div>
            <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
                <span>👨‍✈️</span> Driver Wise Khata — Driver Financial Ledger &amp; Work History
            </h2>
            <p class="text-sm text-slate-500">Track unique working dates, trips across vehicles, advances, and remaining balance.</p>
        </div>
        <button onclick="window.print()" class="btn text-xs">🖨️ Print Ledger</button>
    </div>

    <!-- Filter Bar -->
    <div class="card">
        <form method="get" class="flex flex-wrap items-center gap-4 text-xs">
            <div class="flex items-center gap-2">
                <label class="font-bold text-slate-700">Select Driver:</label>
                <select name="driverName" onchange="this.form.submit()" class="input py-1 px-3 text-xs font-semibold">
                    @foreach (var d in drivers)
                    {
                        <option value="@d" selected="@(selectedDriver == d)">@d</option>
                    }
                </select>
            </div>

            <div class="flex items-center gap-2">
                <span class="text-slate-500">From:</span>
                <input type="date" name="startDate" value="@ViewBag.StartDate" class="input py-1 px-2 text-xs" />
                <span class="text-slate-500">To:</span>
                <input type="date" name="endDate" value="@ViewBag.EndDate" class="input py-1 px-2 text-xs" />
                <button type="submit" class="btn text-xs py-1 px-3">Filter</button>
                <a asp-action="DriverKhata" class="text-red-600 font-semibold hover:underline">Clear</a>
            </div>

            <div class="ml-auto text-xs text-slate-500 flex items-center gap-1.5">
                <span>Vehicles Operated:</span>
                @foreach (var v in vehiclesOperated)
                {
                    <span class="bg-slate-200 text-slate-800 font-bold px-1.5 py-0.5 rounded text-[10px]">#@v</span>
                }
            </div>
        </form>
    </div>

    <!-- Metrics -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        <div class="card">
            <p class="text-[11px] uppercase tracking-wider font-semibold text-slate-500">Working Days</p>
            <p class="text-xl font-bold text-slate-900 mt-1">@uniqueWorkingDays Days</p>
            <p class="text-[9px] text-slate-400 mt-0.5">Unique working dates</p>
        </div>

        <div class="card">
            <p class="text-[11px] uppercase tracking-wider font-semibold text-slate-500">Total Trips</p>
            <p class="text-xl font-bold text-slate-900 mt-1">@totalTrips</p>
        </div>

        <div class="card">
            <p class="text-[11px] uppercase tracking-wider font-semibold text-slate-500">Total Kiraya</p>
            <p class="text-xl font-bold text-green-700 mt-1">Rs. @totalKiraya.ToString("N0")</p>
        </div>

        <div class="card">
            <p class="text-[11px] uppercase tracking-wider font-semibold text-slate-500">Total Kharcha</p>
            <p class="text-xl font-bold text-red-600 mt-1">Rs. @totalKharcha.ToString("N0")</p>
        </div>

        <div class="card">
            <p class="text-[11px] uppercase tracking-wider font-semibold text-slate-500">Total Advance</p>
            <p class="text-xl font-bold text-amber-600 mt-1">Rs. @totalAdvance.ToString("N0")</p>
        </div>

        <div class="card bg-[#1e3a8a] text-white">
            <p class="text-[11px] uppercase tracking-wider font-semibold text-green-300">Driver Baqaya</p>
            <p class="text-xl font-extrabold text-white mt-1">Rs. @driverBaqaya.ToString("N0")</p>
            <p class="text-[9px] text-blue-200 mt-0.5">Kiraya - Kharcha - Advance</p>
        </div>
    </div>

    <!-- Table -->
    <div class="card overflow-x-auto p-0">
        <div class="px-5 py-3 border-b border-slate-200 bg-slate-50 flex justify-between items-center text-xs">
            <span class="font-bold text-slate-800">Work History &amp; Financial Ledger — Driver: @selectedDriver</span>
        </div>
        <table class="tbl">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Vehicle (گاڑی نمبر)</th>
                    <th>Maal</th>
                    <th class="text-right">Diesel</th>
                    <th class="text-right">Kiraya (کرایہ)</th>
                    <th class="text-right">Kharcha (خرچہ)</th>
                    <th class="text-right">Advance (پیشگی)</th>
                    <th class="text-right">Entry Net</th>
                    <th class="text-right">Running Baqaya</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center py-6 text-slate-400">No records found for driver @selectedDriver.</td>
                    </tr>
                }
                else
                {
                    decimal running = 0;
                    @foreach (var r in Model)
                    {
                        var entryNet = r.Kiraya - r.Kharcha - r.Advance;
                        running += entryNet;
                        <tr>
                            <td class="font-medium">@r.Date.ToString("dd-MM-yyyy")</td>
                            <td><span class="bg-slate-100 font-bold px-2 py-0.5 rounded border border-slate-200">#@r.GariNo</span></td>
                            <td class="text-slate-600">@(string.IsNullOrEmpty(r.Maal) ? "—" : r.Maal)</td>
                            <td class="text-right font-mono">@(r.DieselLiter > 0 ? $"{r.DieselLiter} L" : "—")</td>
                            <td class="text-right font-semibold text-green-700">Rs. @r.Kiraya.ToString("N0")</td>
                            <td class="text-right font-semibold text-red-600">Rs. @r.Kharcha.ToString("N0")</td>
                            <td class="text-right font-semibold text-amber-600">Rs. @r.Advance.ToString("N0")</td>
                            <td class="text-right font-medium @(entryNet >= 0 ? "text-slate-800" : "text-red-600")">Rs. @entryNet.ToString("N0")</td>
                            <td class="text-right font-bold @(running >= 0 ? "text-slate-900" : "text-red-600")">Rs. @running.ToString("N0")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
