@model List<OilShop.Core.Models.Gari>
@{
    ViewData["Title"] = "Gariyan Registration (گاڑیاں)";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="card flex justify-between items-center">
        <div>
            <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
                <span>🚛</span> Gariyan Registration (گاڑیاں رجسٹر کریں)
            </h2>
            <p class="text-sm text-slate-500">Register and manage vehicles, ownership (Apni / Kiraye Wali), and default drivers.</p>
        </div>
    </div>

    <!-- Registration Form -->
    <div class="card overflow-hidden">
        <div class="bg-[#1e3a8a] text-white px-5 py-3 rounded-t -m-4 mb-4 flex justify-between items-center">
            <h3 class="font-bold text-sm flex items-center gap-2" id="gariFormHeading">
                <span>➕</span> Register New Vehicle (نئی گاڑی درج کریں)
            </h3>
            <button type="button" onclick="resetGariForm()" class="text-xs bg-blue-900 hover:bg-blue-800 px-2.5 py-1 rounded text-white hidden" id="cancelGariEditBtn">
                Cancel Edit
            </button>
        </div>

        <form asp-action="SaveGari" method="post" id="gariForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="gariId" value="" />

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Vehicle No (گاڑی نمبر) <span class="text-red-500">*</span></label>
                    <input type="text" name="gariNo" id="vehicleNoInput" placeholder="e.g. 537" required class="input font-bold" />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Default Driver (ڈرائیور)</label>
                    <input type="text" name="driverName" id="vehicleDriverInput" placeholder="e.g. Iqbal" class="input" />
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Ownership (ملکیت)</label>
                    <select name="malik" id="vehicleMalikSelect" class="input">
                        <option value="Apni">Apni (Own — اپنی)</option>
                        <option value="Kiraye Wali">Kiraye Wali (Rented — کرائے والی)</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Phone Number (فون نمبر)</label>
                    <input type="text" name="phone" id="vehiclePhoneInput" placeholder="e.g. 0300-1234567" class="input" />
                </div>
            </div>

            <div class="mt-4 pt-4 border-t border-slate-200 flex justify-end gap-2">
                <button type="button" onclick="resetGariForm()" class="btn bg-slate-500 hover:bg-slate-600 text-xs">Reset</button>
                <button type="submit" class="btn btn-green text-xs shadow" id="gariSubmitBtn">Register Vehicle</button>
            </div>
        </form>
    </div>

    <!-- Table -->
    <div class="card overflow-x-auto p-0">
        <table class="tbl">
            <thead>
                <tr>
                    <th>Vehicle No (گاڑی نمبر)</th>
                    <th>Default Driver (ڈرائیور)</th>
                    <th>Ownership (ملکیت)</th>
                    <th>Phone (فون نمبر)</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center py-6 text-slate-400">No vehicles registered yet.</td>
                    </tr>
                }
                else
                {
                    @foreach (var g in Model)
                    {
                        <tr>
                            <td><span class="bg-slate-100 font-bold px-2 py-0.5 rounded border border-slate-200">#@g.GariNo</span></td>
                            <td class="font-semibold">@(string.IsNullOrEmpty(g.DriverName) ? "—" : g.DriverName)</td>
                            <td>
                                <span class="font-bold px-2 py-0.5 rounded text-xs @(g.Malik == "Apni" ? "bg-green-100 text-green-800" : "bg-amber-100 text-amber-800")">
                                    @(g.Malik == "Apni" ? "Apni (Own)" : "Kiraye Wali (Rented)")
                                </span>
                            </td>
                            <td class="font-mono text-slate-600">@(string.IsNullOrEmpty(g.Phone) ? "—" : g.Phone)</td>
                            <td class="text-center">
                                <div class="flex justify-center items-center gap-2">
                                    <button type="button"
                                            onclick="editGari(@g.Id, '@g.GariNo', '@g.DriverName', '@g.Malik', '@g.Phone')"
                                            class="text-blue-600 hover:underline text-xs font-semibold">
                                        Edit
                                    </button>
                                    <form asp-action="DeleteGari" asp-route-id="@g.Id" method="post" onsubmit="return confirm('Delete vehicle #@g.GariNo?');" class="inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="text-red-600 hover:underline text-xs font-semibold">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    function editGari(id, gariNo, driverName, malik, phone) {
        document.getElementById('gariId').value = id;
        document.getElementById('vehicleNoInput').value = gariNo;
        document.getElementById('vehicleDriverInput').value = driverName || '';
        document.getElementById('vehicleMalikSelect').value = malik || 'Apni';
        document.getElementById('vehiclePhoneInput').value = phone || '';

        document.getElementById('gariFormHeading').innerHTML = '<span>✏️</span> Edit Vehicle #' + gariNo;
        document.getElementById('gariSubmitBtn').innerText = 'Update Vehicle';
        document.getElementById('cancelGariEditBtn').classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function resetGariForm() {
        document.getElementById('gariId').value = '';
        document.getElementById('vehicleNoInput').value = '';
        document.getElementById('vehicleDriverInput').value = '';
        document.getElementById('vehicleMalikSelect').value = 'Apni';
        document.getElementById('vehiclePhoneInput').value = '';

        document.getElementById('gariFormHeading').innerHTML = '<span>➕</span> Register New Vehicle (نئی گاڑی درج کریں)';
        document.getElementById('gariSubmitBtn').innerText = 'Register Vehicle';
        document.getElementById('cancelGariEditBtn').classList.add('hidden');
    }
</script>
