@model List<StaffMember>
@{
    ViewData["Title"] = "Staff Management";
    var departments = (List<string>)ViewBag.Departments;
}
<div class="space-y-4">
    <!-- Header stat boxes -->
    <div class="grid grid-cols-3 gap-4">
        <div class="card border-l-4 border-blue-800">
            <div class="text-sm text-slate-500">Total Staff Members</div>
            <div class="text-2xl font-bold text-[#1e3a8a]">@ViewBag.TotalStaff</div>
        </div>
        <div class="card border-l-4 border-green-600">
            <div class="text-sm text-slate-500">Active Staff</div>
            <div class="text-2xl font-bold text-green-600">@ViewBag.ActiveStaff</div>
        </div>
        <div class="card border-l-4 border-amber-500">
            <div class="text-sm text-slate-500">On Leave</div>
            <div class="text-2xl font-bold text-amber-600">@ViewBag.OnLeave</div>
        </div>
    </div>

    <div class="card">
        <div class="flex justify-between items-center mb-3">
            <div>
                <h2 class="font-bold text-lg text-slate-800">Staff Members List</h2>
                <p class="text-xs text-slate-500">View employees, designation, contact, CNIC copies, attendance and ID card</p>
            </div>
            <a class="btn btn-green text-sm" asp-action="Create">+ Add New Staff</a>
        </div>

        <!-- Filter Bar -->
        <div class="bg-slate-50 p-3 rounded border mb-4">
            <form method="get" class="grid md:grid-cols-5 gap-3 items-end">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Search Staff</label>
                    <input class="input w-full text-sm" name="search" value="@ViewBag.Search" placeholder="Name, EMP ID, CNIC, Phone..." />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Department</label>
                    <select class="input w-full text-sm" name="department">
                        <option value="">All Departments</option>
                        @foreach (var d in departments)
                        {
                            if (!string.IsNullOrEmpty(d))
                            {
                                if (ViewBag.Department == d)
                                {
                                    <option value="@d" selected>@d</option>
                                }
                                else
                                {
                                    <option value="@d">@d</option>
                                }
                            }
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Joining From</label>
                    <input class="input w-full text-sm" type="date" name="fromDate" value="@ViewBag.FromDate" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Joining To</label>
                    <input class="input w-full text-sm" type="date" name="toDate" value="@ViewBag.ToDate" />
                </div>
                <div class="flex gap-2">
                    <button type="submit" class="btn w-full text-sm">🔍 Filter</button>
                    <a asp-action="Index" class="btn text-sm">Reset</a>
                </div>
            </form>
        </div>

        <table class="tbl">
            <thead>
                <tr>
                    <th>Emp ID</th>
                    <th>Photo</th>
                    <th>Name</th>
                    <th>CNIC</th>
                    <th>Designation</th>
                    <th>Department</th>
                    <th>Contact</th>
                    <th>Salary</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td class="font-mono font-semibold text-[#1e3a8a]">
                        <a asp-action="Details" asp-route-id="@s.Id" class="hover:underline">@s.EmployeeId</a>
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(s.PhotoPath))
                        {
                            <img src="@s.PhotoPath" alt="Photo" class="w-8 h-8 rounded-full object-cover border" />
                        }
                        else
                        {
                            <div class="w-8 h-8 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center font-bold text-xs">@s.Name.Substring(0, 1)</div>
                        }
                    </td>
                    <td class="font-bold">
                        <a asp-action="Details" asp-route-id="@s.Id" class="hover:underline">@s.Name</a>
                    </td>
                    <td class="text-xs font-mono">
                        @(s.Cnic ?? "—")
                        @if (!string.IsNullOrEmpty(s.CnicFrontPath) || !string.IsNullOrEmpty(s.CnicBackPath))
                        {
                            <span class="inline-block px-1 bg-green-100 text-green-800 rounded font-sans text-[10px]">Doc</span>
                        }
                    </td>
                    <td>@s.Designation</td>
                    <td class="text-xs text-slate-600">@s.Department</td>
                    <td>@s.ContactNumber</td>
                    <td class="font-semibold text-slate-800">Rs. @s.Salary.ToString("N0")</td>
                    <td>
                        <span class="px-2 py-0.5 rounded text-xs font-semibold @(s.OnLeave ? "bg-amber-100 text-amber-800" : (s.IsActive ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800"))">
                            @(s.OnLeave ? "On Leave" : (s.IsActive ? "Active" : "Inactive"))
                        </span>
                    </td>
                    <td class="space-x-2 text-xs">
                        <a class="text-blue-700 hover:underline font-semibold" asp-action="Details" asp-route-id="@s.Id">ID Card</a>
                        <a class="text-slate-700 hover:underline font-semibold" asp-action="Edit" asp-route-id="@s.Id">Edit</a>
                        <form asp-action="Delete" asp-route-id="@s.Id" method="post" onsubmit="return confirm('Delete staff @s.Name?');" class="inline">
                            <button type="submit" class="text-red-600 hover:underline font-semibold">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="10" class="text-center py-6 text-slate-500">No staff records found matching filter.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
