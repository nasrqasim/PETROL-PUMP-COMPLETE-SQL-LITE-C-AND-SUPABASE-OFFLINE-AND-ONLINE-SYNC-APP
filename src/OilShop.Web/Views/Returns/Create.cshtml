@model Return
@{
    ViewData["Title"] = "New Return";
    var customers = (List<Customer>)ViewBag.Customers;
    var suppliers = (List<Supplier>)ViewBag.Suppliers;
    var products = (List<Product>)ViewBag.Products;
}
<div class="card max-w-2xl">
    <h2 class="font-bold text-lg mb-3">Sales Return / Purchase Return Entry</h2>
    <form asp-action="Create" method="post" class="space-y-3">
        <div class="grid md:grid-cols-2 gap-3">
            <div><label class="text-sm">Return Type</label>
                <select class="input" asp-for="Type"><option>SalesReturn</option><option>PurchaseReturn</option></select></div>
            <div><label class="text-sm">Date</label><input class="input" asp-for="Date" type="date" required /></div>
            <div><label class="text-sm">Customer (for Sales Return)</label>
                <select class="input" asp-for="CustomerId"><option value="">—</option>
                    @foreach (var c in customers) { <option value="@c.Id">@c.Name</option> }
                </select></div>
            <div><label class="text-sm">Supplier (for Purchase Return)</label>
                <select class="input" asp-for="SupplierId"><option value="">—</option>
                    @foreach (var s in suppliers) { <option value="@s.Id">@s.Name</option> }
                </select></div>
            <div><label class="text-sm">Original Invoice No.</label><input class="input" asp-for="OriginalInvoiceNumber" placeholder="e.g. SI-004587" /></div>
            <div><label class="text-sm">Product</label>
                <select class="input" asp-for="ProductId" required>
                    @foreach (var p in products) { <option value="@p.Id">@p.Name</option> }
                </select></div>
            <div><label class="text-sm">Returned Quantity</label><input class="input" asp-for="ReturnedQuantity" type="number" step="0.01" min="0" required /></div>
            <div><label class="text-sm">Unit Price Rs.</label><input class="input" asp-for="UnitPrice" type="number" step="0.01" min="0" required /></div>
        </div>
        <div><label class="text-sm">Reason for Return</label><input class="input" asp-for="Reason" placeholder="e.g. Customer returned excess fuel" required /></div>
        <div><label class="text-sm">Remarks</label><input class="input" asp-for="Remarks" /></div>
        <button class="btn btn-green" type="submit">Save Return</button>
    </form>
    <p class="text-xs text-slate-500 mt-2">Saving a return restores stock and adjusts the khata automatically.</p>
</div>
