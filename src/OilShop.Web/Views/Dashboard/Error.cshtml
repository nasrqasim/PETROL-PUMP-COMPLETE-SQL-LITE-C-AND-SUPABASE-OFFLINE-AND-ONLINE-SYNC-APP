@{
    ViewData["Title"] = "Error";
}
<div class="card">
    <h2 class="font-bold text-lg text-red-700">Something went wrong</h2>
    <p class="text-slate-600 mt-2">Please try again. If the problem continues, check the log or restart the app.</p>
    <a class="btn mt-4" asp-controller="Dashboard" asp-action="Index">Back to Dashboard</a>
</div>
