@model List<Expense>
@{
    ViewData["Title"] = "Expenses Management";
    var categories = (List<string>)ViewBag.Categories;
}
<div class="space-y-4">
    <div class="flex justify-between items-center">
        <div>
            <h2 class="font-bold text-xl text-slate-800">Shop Expenses</h2>
            <p class="text-xs text-slate-500">Track and manage daily utilities, rent, salaries, transport, and miscellaneous costs</p>
        </div>
        <div class="flex gap-3 items-center">
            <div class="bg-red-50 border border-red-200 px-4 py-1.5 rounded-lg text-right">
                <span class="text-xs text-red-700 font-semibold uppercase">Total Filtered</span>
                <span class="text-xl font-black text-red-800 ml-2">Rs. @(((decimal)ViewBag.TotalExpense).ToString("N0"))</span>
            </div>
            <a asp-action="Create" class="btn btn-green text-sm">+ Add Expense</a>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card bg-slate-50 border">
        <form method="get" class="grid md:grid-cols-5 gap-3 items-end">
            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Search Keywords</label>
                <input class="input w-full text-sm" name="search" value="@ViewBag.Search" placeholder="Category, remarks..." />
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Category</label>
                <select class="input w-full text-sm" name="category">
                    <option value="">All Categories</option>
                    @foreach (var c in categories)
                    {
                        if (ViewBag.Category == c)
                        {
                            <option value="@c" selected>@c</option>
                        }
                        else
                        {
                            <option value="@c">@c</option>
                        }
                    }
                </select>
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">From Date</label>
                <input class="input w-full text-sm" type="date" name="fromDate" value="@ViewBag.FromDate" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">To Date</label>
                <input class="input w-full text-sm" type="date" name="toDate" value="@ViewBag.ToDate" />
            </div>
            <div class="flex gap-2">
                <button type="submit" class="btn w-full text-sm">🔍 Filter</button>
                <a asp-action="Index" class="btn text-sm">Reset</a>
            </div>
        </form>
    </div>

    <!-- Table -->
    <div class="card overflow-x-auto">
        <table class="tbl">
            <thead>
                <tr>
                    <th>Expense #</th>
                    <th>Date</th>
                    <th>Category</th>
                    <th>Paid From</th>
                    <th>Remarks</th>
                    <th class="text-right">Amount</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td class="font-mono text-xs font-semibold">EXP-@e.Id.ToString("D4")</td>
                        <td>@e.Date.ToString("dd-MMM-yyyy")</td>
                        <td class="font-bold text-slate-800">@e.Category</td>
                        <td>
                            <span class="px-2 py-0.5 rounded text-xs font-semibold @(e.PaidFrom == PaymentMode.Cash ? "bg-amber-100 text-amber-800" : "bg-blue-100 text-blue-800")">
                                @e.PaidFrom
                            </span>
                        </td>
                        <td class="text-slate-600 text-sm">@e.Remarks</td>
                        <td class="text-right font-bold text-red-600">Rs. @e.Amount.ToString("N0")</td>
                        <td class="space-x-2">
                            <a asp-action="Edit" asp-route-id="@e.Id" class="text-blue-700 hover:underline text-xs">Edit</a>
                            <form asp-action="Delete" asp-route-id="@e.Id" method="post" onsubmit="return confirm('Delete this expense?');" class="inline">
                                <button type="submit" class="text-red-600 hover:underline text-xs">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center py-6 text-slate-500">No expenses recorded for this filter criteria.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
