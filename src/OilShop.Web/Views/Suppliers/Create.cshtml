@model Supplier
@{
    ViewData["Title"] = "Add Supplier";
}
<div class="card max-w-lg">
    <h2 class="font-bold text-lg mb-3">Add Supplier</h2>
    <form asp-action="Create" method="post" class="space-y-3">
        <input class="input" asp-for="Name" placeholder="Supplier Name" required />
        <input class="input" asp-for="Phone" placeholder="Phone" required />
        <input class="input" asp-for="Address" placeholder="Address" />
        <input class="input" asp-for="Email" placeholder="Email" />
        <input class="input" asp-for="NTN" placeholder="NTN" />
        <button class="btn" type="submit">Save Supplier</button>
    </form>
</div>
