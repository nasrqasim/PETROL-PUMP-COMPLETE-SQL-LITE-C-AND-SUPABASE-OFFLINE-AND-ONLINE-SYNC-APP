@model List<Supplier>
@{
    ViewData["Title"] = "Suppliers Ledger";
}
<div class="space-y-4">
    <div class="card">
        <div class="flex justify-between items-center mb-3">
            <div>
                <h2 class="font-bold text-lg text-slate-800">Supplier / Vendor Accounts</h2>
                <p class="text-xs text-slate-500">Manage oil &amp; lubricant suppliers, monitor payables, and edit company profiles</p>
            </div>
            <a class="btn btn-green text-sm" asp-action="Create">+ Add Supplier</a>
        </div>

        <!-- Filter Bar -->
        <div class="bg-slate-50 p-3 rounded border mb-4">
            <form method="get" class="grid md:grid-cols-4 gap-3 items-end">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Search Supplier</label>
                    <input class="input w-full text-sm" name="search" value="@ViewBag.Search" placeholder="Name, phone, NTN, address..." />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Created From</label>
                    <input class="input w-full text-sm" type="date" name="fromDate" value="@ViewBag.FromDate" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Created To</label>
                    <input class="input w-full text-sm" type="date" name="toDate" value="@ViewBag.ToDate" />
                </div>
                <div class="flex gap-2">
                    <button type="submit" class="btn w-full text-sm">🔍 Filter</button>
                    <a asp-action="Index" class="btn text-sm">Reset</a>
                </div>
            </form>
        </div>

        <table class="tbl">
            <thead>
                <tr>
                    <th>Supplier / Company</th>
                    <th>Phone</th>
                    <th>Address</th>
                    <th>NTN</th>
                    <th class="text-right">Balance Due (Payable)</th>
                    <th class="text-right">Advance Paid</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td class="font-bold text-[#1e3a8a]">
                        <a asp-action="Details" asp-route-id="@s.Id" class="hover:underline">@s.Name</a>
                    </td>
                    <td>@s.Phone</td>
                    <td class="text-xs text-slate-600">@s.Address</td>
                    <td class="font-mono text-xs">@s.NTN</td>
                    <td class="text-right font-bold text-red-600">Rs. @s.BalanceDue.ToString("N0")</td>
                    <td class="text-right text-slate-600">Rs. @s.Advance.ToString("N0")</td>
                    <td class="space-x-2 text-xs">
                        <a class="text-blue-700 hover:underline font-semibold" asp-action="Details" asp-route-id="@s.Id">Ledger</a>
                        <a class="text-slate-700 hover:underline font-semibold" asp-action="Edit" asp-route-id="@s.Id">Edit</a>
                        <form asp-action="Delete" asp-route-id="@s.Id" method="post" onsubmit="return confirm('Delete supplier @s.Name?');" class="inline">
                            <button type="submit" class="text-red-600 hover:underline font-semibold">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center py-6 text-slate-500">No suppliers found matching filter.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
