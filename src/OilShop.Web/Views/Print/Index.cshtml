@model SalesInvoice?
@{
    ViewData["Title"] = "Print Preview";
    var customer = (Customer?)ViewBag.Customer;
    var invoices = (List<SalesInvoice>)ViewBag.Invoices;
    var payments = (List<Payment>)ViewBag.Payments;
    var settings = (ShopSettings?)ViewBag.Settings;
    var allInvoices = (List<SalesInvoice>)ViewBag.AllInvoices;
    var allCustomers = (List<Customer>)ViewBag.AllCustomers;
}
<div class="flex gap-2 mb-4 no-print">
    <form method="get" class="flex gap-2">
        <select class="input max-w-xs" name="invoiceId" onchange="this.form.submit()">
            <option value="">Select Invoice...</option>
            @foreach (var inv in allInvoices) {
                if (Model?.Id == inv.Id) {
                    <option value="@inv.Id" selected>@inv.InvoiceNumber — @inv.Customer?.Name</option>
                } else {
                    <option value="@inv.Id">@inv.InvoiceNumber — @inv.Customer?.Name</option>
                }
            }
        </select>
    </form>
    <form method="get" class="flex gap-2">
        <select class="input max-w-xs" name="customerId" onchange="this.form.submit()">
            <option value="">Select Customer Ledger...</option>
            @foreach (var c in allCustomers) {
                if (customer?.Id == c.Id) {
                    <option value="@c.Id" selected>@c.Name</option>
                } else {
                    <option value="@c.Id">@c.Name</option>
                }
            }
        </select>
    </form>
</div>

<div class="flex gap-2 mb-4 no-print">
    <button class="btn" onclick="window.print()">🖨️ Print</button>
    <button class="btn" onclick="window.print()">📄 PDF Download</button>
    <button class="btn" onclick="alert('Use your browser screenshot / Save as Image to capture this preview.')">🖼️ Save as Image</button>
    <button class="btn btn-green" onclick="if (navigator.share) { navigator.share({ title: 'Invoice', text: 'Oil Shop Invoice' }); } else { alert('Copy the page link to share this document.'); }">🔗 Share Document</button>
</div>

<div class="grid md:grid-cols-2 gap-4">
    <div class="card">
        <h2 class="font-bold text-lg mb-2">Invoice Print Preview</h2>
        @if (Model is not null)
        {
            <div class="border rounded p-4">
                <div class="flex justify-between">
                    <div class="font-black text-[#1e3a8a]">ROONJHA DEVELOPERS<br /><span class="text-sm font-normal">Oil Shop</span></div>
                    <div class="text-right text-sm">
                        <div class="font-bold">Sales Invoice</div>
                        <div>@Model.InvoiceNumber</div>
                        <div>@Model.Date.ToString("dd-MMM-yyyy")</div>
                    </div>
                </div>
                <p class="mt-2 text-sm"><strong>Customer:</strong> @Model.Customer?.Name<br />
                <strong>Address:</strong> @Model.Customer?.Address<br />
                <strong>Phone:</strong> @Model.Customer?.Phone</p>
                <table class="tbl mt-2">
                    <thead><tr><th>Description</th><th>Qty</th><th>Unit Price</th><th class="text-right">Total</th></tr></thead>
                    <tbody>
                    @foreach (var l in Model.Lines)
                    {
                        <tr><td>@l.ProductName</td><td>@l.Quantity</td><td>Rs. @l.UnitPrice.ToString("N0")</td><td class="text-right">Rs. @l.TotalAmount.ToString("N0")</td></tr>
                    }
                    </tbody>
                </table>
                <div class="text-right mt-2">Subtotal: Rs. @Model.SubTotal.ToString("N0")<br />Tax: Rs. @Model.Tax.ToString("N0")</div>
                <div class="text-right text-xl font-bold">Grand Total: Rs. @Model.GrandTotal.ToString("N0")</div>
                <p class="text-xs text-slate-500 mt-2">@settings?.ReceiptFooterText</p>
            </div>
        }
        else
        {
            <p class="text-slate-500">No invoice selected.</p>
        }
    </div>
    <div class="card">
        <h2 class="font-bold text-lg mb-2">Customer Ledger Account Statement</h2>
        @if (customer is not null)
        {
            <p class="text-sm"><strong>@customer.Name</strong> — @customer.Phone<br />Balance Due: <strong class="text-red-600">Rs. @customer.BalanceDue.ToString("N0")</strong> | Advance: <strong class="text-green-600">Rs. @customer.Advance.ToString("N0")</strong></p>
            <table class="tbl mt-2">
                <thead><tr><th>Date</th><th>Invoice / Voucher</th><th class="text-right">Debit</th><th class="text-right">Credit</th></tr></thead>
                <tbody>
                @foreach (var i in invoices)
                {
                    <tr><td>@i.Date.ToString("dd-MMM-yyyy")</td><td>@i.InvoiceNumber</td><td class="text-right">Rs. @i.GrandTotal.ToString("N0")</td><td class="text-right">—</td></tr>
                }
                @foreach (var p in payments)
                {
                    <tr><td>@p.Date.ToString("dd-MMM-yyyy")</td><td>@p.VoucherNumber</td><td class="text-right">—</td><td class="text-right">Rs. @p.Amount.ToString("N0")</td></tr>
                }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-slate-500">Select a customer to view their ledger statement.</p>
        }
    </div>
</div>
